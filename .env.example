# --- Database ---
DATABASE_URL="postgresql://clipcutter:clipcutter@localhost:5432/clipcutter?schema=public"

# --- Redis / Queue ---
REDIS_URL="redis://localhost:6379"
WORKER_CONCURRENCY="2"

# --- Object storage (S3-compatible: AWS S3 or Cloudflare R2) ---
S3_ENDPOINT="http://localhost:9000"          # e.g. https://<account_id>.r2.cloudflarestorage.com for R2, or unset for AWS S3
S3_REGION="auto"                              # "auto" for R2, e.g. "us-east-1" for AWS
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="clipcutter-media"
S3_FORCE_PATH_STYLE="true"                    # true for MinIO/R2, false for AWS S3

# --- Auth ---
NEXTAUTH_SECRET="replace-with-a-long-random-string"
SESSION_COOKIE_NAME="clipcutter_session"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Limits (see lib/limits.ts for how these are consumed) ---
MAX_FILE_SIZE_FREE_MB="500"
MAX_FILE_SIZE_PREMIUM_MB="5000"
MAX_CLIP_DURATION_FREE_SEC="600"
MAX_CLIP_DURATION_PREMIUM_SEC="7200"
MAX_DAILY_JOBS_FREE="10"
MAX_DAILY_JOBS_PREMIUM="500"
MAX_RESOLUTION_HEIGHT_FREE="1080"
MAX_RESOLUTION_HEIGHT_PREMIUM="4320"
MAX_CONCURRENT_JOBS_FREE="1"
MAX_CONCURRENT_JOBS_PREMIUM="5"

FILE_EXPIRY_HOURS="24"

# --- Rate limiting (requests per window per IP/user) ---
RATE_LIMIT_AUTH_PER_MIN="10"
RATE_LIMIT_UPLOAD_PER_MIN="5"
RATE_LIMIT_JOB_CREATE_PER_MIN="10"
RATE_LIMIT_API_PER_MIN="120"
RATE_LIMIT_DOWNLOAD_PER_MIN="30"

# --- Stripe (billing architecture; safe to leave blank in dev) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_PREMIUM=""

# --- Admin bootstrap (optional, first-run only) ---
ADMIN_EMAIL=""
