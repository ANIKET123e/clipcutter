{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "outDir": "dist-worker",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": { "@/*": ["./*"] }
  },
  "include": ["workers/**/*.ts", "lib/**/*.ts", "services/**/*.ts", "queues/**/*.ts", "types/**/*.ts", "db/**/*.ts"]
}
